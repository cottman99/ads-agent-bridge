{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cottman99/ads-agent-bridge/docs/schemas/ads-design-plan-v1.schema.json",
  "title": "ADS structured design plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "source_workspace", "output_workspace", "design", "expected_before", "operations", "assertions"],
  "properties": {
    "schema_version": {"const": "ads.design-plan/v1"},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "source_workspace": {"type": "string", "minLength": 1},
    "output_workspace": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instance": {"type": "string", "minLength": 1},
    "design": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}:[A-Za-z_][A-Za-z0-9_]{0,127}:schematic$"},
    "expected_before": {"$ref": "#/$defs/name_assertion"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/add_instance"},
          {"$ref": "#/$defs/add_wire"}
        ]
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "instance_names": {"$ref": "#/$defs/string_list"},
        "netlist_contains": {"$ref": "#/$defs/string_list"},
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instance", "parameter", "value"],
            "properties": {
              "instance": {"type": "string", "minLength": 1, "maxLength": 128},
              "parameter": {"type": "string", "minLength": 1, "maxLength": 128},
              "value": {"type": "string", "maxLength": 256}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "string_list": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "name_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_names"],
      "properties": {"instance_names": {"$ref": "#/$defs/string_list"}}
    },
    "add_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "item", "at", "name"],
      "properties": {
        "op": {"const": "add_instance"},
        "item": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}, "minItems": 3, "maxItems": 3},
        "at": {"$ref": "#/$defs/point"},
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
        "angle": {"type": "number"},
        "parameters": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 256}}
      }
    },
    "add_wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "points"],
      "properties": {
        "op": {"const": "add_wire"},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}, "minItems": 2},
        "label": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
